# Production settings for docker-compose.prod.yml.
# On the server: copy to .env next to docker-compose.prod.yml, fill in every value, then `chmod 600 .env`.
# Never commit the filled-in file.

# --- Images (pushed to ECR by deploy/build-and-push.ps1) --------------------------------------
# Use the exact tag you were given (not "latest") so a bad release can be rolled back.
WEB_IMAGE=464092293482.dkr.ecr.ap-south-1.amazonaws.com/dhi_tech_forum:web-REPLACE_TAG
API_IMAGE=464092293482.dkr.ecr.ap-south-1.amazonaws.com/dhi_tech_forum:api-REPLACE_TAG
AI_IMAGE=464092293482.dkr.ecr.ap-south-1.amazonaws.com/dhi_tech_forum:ai-REPLACE_TAG

# --- Public URL ------------------------------------------------------------------------------
# The https address users open. The app and the API share it (the API lives under /api).
APP_URL=https://onboarding.example.com
# Host port the web container listens on. Point HTTPS (load balancer / Caddy / nginx) at it.
WEB_PORT=80

# --- Secrets ---------------------------------------------------------------------------------
# Laravel encryption key. Generate once and keep it:  echo "base64:$(openssl rand -base64 32)"
APP_KEY=
# Shared secret between the API and the AI service. At least 16 random characters, e.g. `openssl rand -hex 32`.
AI_INTERNAL_KEY=
# Anthropic API key (https://console.anthropic.com). Set a monthly spend limit there too.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# --- MongoDB ---------------------------------------------------------------------------------
# Must support $vectorSearch: MongoDB Atlas (recommended) or the bundled Atlas Local container.
# Atlas:        mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
# Atlas Local:  start with --profile local-mongo and use
#               mongodb://admin:MONGO_ROOT_PASSWORD@mongo:27017/?directConnection=true&authSource=admin
MONGODB_URI=
MONGODB_DB=onboarding_assistant
# Only for --profile local-mongo.
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=

# --- Uploaded document files -----------------------------------------------------------------
# "s3" (private bucket, recommended) or "local" (Docker volume on this server).
DOCUMENTS_DISK=s3
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=
# Leave both empty when the server has an IAM role with s3:GetObject/PutObject/DeleteObject on the bucket.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# --- Access and cost controls ----------------------------------------------------------------
# false = only admins can create accounts.
REGISTRATION_ENABLED=true
# Comma-separated email domains allowed to self sign-up, e.g. company.com. Empty allows any domain.
REGISTRATION_ALLOWED_DOMAINS=
# Chat questions per user per minute.
CHAT_RATE_LIMIT_PER_MINUTE=20
# Minutes a login stays valid (10080 = 7 days).
SANCTUM_TOKEN_EXPIRATION=10080
