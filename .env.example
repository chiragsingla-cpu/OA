# Copy to .env and fill in. docker compose reads this file automatically.

# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=

# Claude model used for classification and answers. Haiku 4.5 is the low-cost option.
ANTHROPIC_MODEL=claude-haiku-4-5

# Shared secret between Laravel and the AI service. Use a long random string.
AI_INTERNAL_KEY=change-me-to-a-long-random-string

MONGODB_DB=onboarding_assistant
